rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'YOUR_ADMIN_EMAIL'
        && request.auth.token.email_verified == true;
    }

    // Public website reads gallery; only verified Admin can manage it.
    match /gallery/{photoId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title','url','storagePath','createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.url is string
        && request.resource.data.url.matches('https://.*')
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('gallery/.*');
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Anyone may submit a bounded selection; only Admin may read or change it.
    match /selections/{selectionId} {
      allow create: if request.resource.data.keys().hasOnly([
          'customerName','customerPhone','customerNote','photos','status','createdAt'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() > 0
        && request.resource.data.customerPhone.size() <= 20
        && request.resource.data.customerNote is string
        && request.resource.data.customerNote.size() <= 500
        && request.resource.data.photos is list
        && request.resource.data.photos.size() > 0
        && request.resource.data.photos.size() <= 100
        && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    // Customer profile collection is private by default.
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }
  }
}
